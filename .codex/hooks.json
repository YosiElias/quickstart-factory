{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/openshift-policy.sh\" --client codex",
            "timeout": 10,
            "async": false,
            "statusMessage": "Checking OpenShift approval request"
          }
        ]
      }
    ]
  }
}

{
  "permissions": {
    "deny": [
      "Read(./.claude/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Read(./core/oc-policy-gate/**)",
      "Edit(./core/oc-policy-gate/**)",
      "Write(./core/oc-policy-gate/**)"
    ], 
    "allow": [
      "Bash(python3 core/flow/pipeline-checkpoint.py*)",
      "Bash(python3 core/scripts/generate-kb-index.py*)",
      "Bash(python3 core/scripts/idf-score-kb.py*)",
      "Bash(python3 core/scripts/select-top-kb.py*)",
      "Bash(mkdir -p .rhoai-qs/*)",
      "Bash(mkdir -p .tmp/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*oc *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/openshift-policy.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(*kubectl *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/openshift-policy.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(*helm *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/openshift-policy.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
